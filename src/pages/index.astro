---
import '../styles/global.css';

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const currentYear = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="J5 Star Studio is an independent game development studio creating immersive worlds, engaging systems, and memorable player experiences." />
    <meta name="theme-color" content="#090E1B" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content="J5 Star Studio" />
    <meta property="og:description" content="Creating Worlds Beyond Imagination." />
    <meta property="og:image" content="https://j5starstudio.github.io/og-card.svg" />
    <meta property="og:image:alt" content="J5 Star Studio — Creating Worlds Beyond Imagination." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="J5 Star Studio" />
    <meta name="twitter:description" content="Creating Worlds Beyond Imagination." />
    <meta name="twitter:image" content="https://j5starstudio.github.io/og-card.svg" />
    <title>J5 Star Studio — Independent Game Studio</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <canvas id="starfield" aria-hidden="true"></canvas>

    <header class="site-header" data-header>
      <a class="brand" href="#home" aria-label="J5 Star Studio home">
        <img src="/favicon.svg" width="34" height="34" alt="" />
        <span>J5 Star Studio</span>
      </a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" aria-label="Open navigation menu">
        <span></span><span></span><span></span>
      </button>
      <nav id="primary-nav" class="primary-nav" aria-label="Primary navigation">
        <a href="#home">Home</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </nav>
    </header>

    <main id="main">
      <section id="home" class="hero section-shell" aria-labelledby="hero-title">
        <div class="orbit orbit-one" aria-hidden="true"></div>
        <div class="orbit orbit-two" aria-hidden="true"></div>
        <p class="eyebrow">Independent Game Studio</p>
        <img class="emblem" src="/logo.svg" width="320" height="320" alt="J5 Star Studio celestial star emblem" fetchpriority="high" decoding="async" />
        <h1 id="hero-title">J5 Star Studio</h1>
        <p class="tagline">Creating Worlds<br /><em>Beyond Imagination.</em></p>
        <a class="scroll-cue" href="#about"><span>Discover our story</span><span aria-hidden="true">↓</span></a>
      </section>

      <section id="about" class="about section-shell" aria-labelledby="about-title">
        <div class="section-number" aria-hidden="true">01</div>
        <div class="section-heading">
          <p class="eyebrow">Who we are</p>
          <h2 id="about-title">Crafted with purpose.<br />Built to be remembered.</h2>
        </div>
        <div class="about-copy">
          <p class="lead">We are an independent game development studio dedicated to creating immersive worlds, engaging systems, and memorable player experiences.</p>
          <p>Every project begins with curiosity. We explore the space between art and technology, shaping thoughtful experiences where every detail serves the world around it.</p>
          <div class="values" aria-label="Studio values">
            <span>Immersive Worlds</span><span>Meaningful Systems</span><span>Lasting Experiences</span>
          </div>
        </div>
      </section>

      <section id="journey" class="journey section-shell" aria-labelledby="journey-title">
        <div class="journey-intro">
          <p class="eyebrow">Our journey</p>
          <h2 id="journey-title">Something new is<br />taking shape.</h2>
          <p>We are currently focused on the quiet, deliberate work of building original experiences. Our worlds are still beyond the horizon—but every day brings them closer.</p>
        </div>
        <div class="celestial-map" aria-hidden="true">
          <div class="path-line"></div>
          <div class="milestone milestone-one"><i></i><span>Imagine</span></div>
          <div class="milestone milestone-two"><i></i><span>Shape</span></div>
          <div class="milestone milestone-three"><i></i><span>Explore</span></div>
          <div class="horizon-star">✦</div>
        </div>
      </section>

      <section id="contact" class="contact section-shell" aria-labelledby="contact-title">
        <div class="contact-star" aria-hidden="true">✦</div>
        <p class="eyebrow">Find us among the stars</p>
        <h2 id="contact-title">Follow the journey.</h2>
        <p>Explore our public work and stay connected as the next chapter unfolds.</p>
        <a class="github-link" href="https://github.com/J5starStudio" target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.42c.58.1.79-.25.79-.56v-2.02c-3.22.7-3.9-1.36-3.9-1.36-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.28-5.27-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.16 1.18A10.98 10.98 0 0 1 12 6.32c.98 0 1.96.13 2.88.39 2.2-1.49 3.16-1.18 3.16-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.71 5.38-5.29 5.67.42.36.79 1.06.79 2.14v3.08c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z"/></svg>
          <span>Visit J5starStudio on GitHub</span><span aria-hidden="true">↗</span>
        </a>
      </section>
    </main>

    <footer>
      <a class="brand" href="#home"><img src="/favicon.svg" width="28" height="28" alt="" /><span>J5 Star Studio</span></a>
      <p>© {currentYear} J5 Star Studio. All rights reserved.</p>
      <p class="footer-note">Made for worlds yet unseen.</p>
    </footer>

    <script>
      const menuButton = document.querySelector<HTMLButtonElement>('.menu-toggle');
      const nav = document.querySelector<HTMLElement>('.primary-nav');
      const closeMenu = () => {
        menuButton?.setAttribute('aria-expanded', 'false');
        menuButton?.setAttribute('aria-label', 'Open navigation menu');
        nav?.classList.remove('is-open');
      };
      menuButton?.addEventListener('click', () => {
        const isOpen = menuButton.getAttribute('aria-expanded') === 'true';
        menuButton.setAttribute('aria-expanded', String(!isOpen));
        menuButton.setAttribute('aria-label', isOpen ? 'Open navigation menu' : 'Close navigation menu');
        nav?.classList.toggle('is-open', !isOpen);
      });
      nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
      document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeMenu(); });

      const canvas = document.querySelector<HTMLCanvasElement>('#starfield');
      const context = canvas?.getContext('2d');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      type Star = { x: number; y: number; radius: number; alpha: number; phase: number };
      let stars: Star[] = [];
      let animationFrame = 0;
      const drawStars = (time = 0) => {
        if (!canvas || !context) return;
        context.clearRect(0, 0, canvas.width, canvas.height);
        for (const star of stars) {
          const shimmer = reduceMotion.matches ? star.alpha : star.alpha * (0.72 + Math.sin(time * 0.0007 + star.phase) * 0.28);
          context.beginPath();
          context.arc(star.x, star.y, star.radius, 0, Math.PI * 2);
          context.fillStyle = `rgba(233, 229, 218, ${shimmer})`;
          context.fill();
        }
        if (!reduceMotion.matches) animationFrame = requestAnimationFrame(drawStars);
      };
      const resizeStars = () => {
        if (!canvas || !context) return;
        cancelAnimationFrame(animationFrame);
        const density = Math.min(180, Math.floor((innerWidth * innerHeight) / 9500));
        const dpr = Math.min(devicePixelRatio, 2);
        canvas.width = innerWidth * dpr;
        canvas.height = innerHeight * dpr;
        canvas.style.width = `${innerWidth}px`;
        canvas.style.height = `${innerHeight}px`;
        context.setTransform(dpr, 0, 0, dpr, 0, 0);
        stars = Array.from({ length: density }, (_, index) => ({
          x: ((index * 7919) % 1000) / 1000 * innerWidth,
          y: ((index * 6271 + 173) % 1000) / 1000 * innerHeight,
          radius: index % 17 === 0 ? 1.35 : 0.7,
          alpha: 0.18 + (index % 7) * 0.07,
          phase: index * 0.83
        }));
        drawStars();
      };
      resizeStars();
      addEventListener('resize', resizeStars, { passive: true });
      reduceMotion.addEventListener('change', resizeStars);
    </script>
  </body>
</html>
